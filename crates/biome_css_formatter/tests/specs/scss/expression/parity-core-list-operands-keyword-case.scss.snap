# Input

```scss
@use "sass:list";
@use "sass:meta";

$x:[NOT];
.uppercase-not{length:list.length($x);value:meta.inspect($x);}

$x:[foo AND];
.uppercase-and{length:list.length($x);value:meta.inspect($x);}

$x:[true OR false];
.uppercase-or{length:list.length($x);value:meta.inspect($x);}

$x:[not false AND];
.mixed-operator-tail{length:list.length($x);value:meta.inspect($x);}

$x:[Not false,nOt false,noT false];
.mixed-case-not{length:list.length($x);value:meta.inspect($x);}

$x:[true aNd false,false oR true];
.mixed-case-binary{length:list.length($x);value:meta.inspect($x);}

$x:[not false,true and not false,false or true];
.lowercase-operators{length:list.length($x);value:meta.inspect($x);}

$x:[n\6f t false,\6e ot false,true a\6e d false,false o\72  true];
.escaped-operators{length:list.length($x);value:meta.inspect($x);}

$x:[N\4f T false,true \61 nd false,false \6f r true];
.escaped-identifiers{length:list.length($x);value:meta.inspect($x);}

```


# Formatted

```scss
@use "sass:list";
@use "sass:meta";

$x: [NOT];
.uppercase-not {
	length: list.length($x);
	value: meta.inspect($x);
}

$x: [foo AND];
.uppercase-and {
	length: list.length($x);
	value: meta.inspect($x);
}

$x: [true OR false];
.uppercase-or {
	length: list.length($x);
	value: meta.inspect($x);
}

$x: [not false AND];
.mixed-operator-tail {
	length: list.length($x);
	value: meta.inspect($x);
}

$x: [Not false, nOt false, noT false];
.mixed-case-not {
	length: list.length($x);
	value: meta.inspect($x);
}

$x: [true aNd false, false oR true];
.mixed-case-binary {
	length: list.length($x);
	value: meta.inspect($x);
}

$x: [not false, true and not false, false or true];
.lowercase-operators {
	length: list.length($x);
	value: meta.inspect($x);
}

$x: [n\6f t false, \6e ot false, true a\6e d false, false o\72  true];
.escaped-operators {
	length: list.length($x);
	value: meta.inspect($x);
}

$x: [N\4f T false, true \61 nd false, false \6f r true];
.escaped-identifiers {
	length: list.length($x);
	value: meta.inspect($x);
}

```
