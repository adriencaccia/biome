## Input

```css
@use "sass:map";
@use "sass:list";

$gap: 8px; $a: -$gap; $b: +$gap; $c: not false; $d: 1 < 2;
.case-assignment-operands { minus:$a; plus:$b; negated:$c; comparison:$d; }

$gap: 8px; @function identity($x) { @return $x; }
.case-call-operands { minus:identity(-$gap); plus:identity(+$gap); negated:identity(not false); comparison:identity(1 < 2); }

$gap: 8px;
@mixin values($a: -$gap, $b: +$gap, $c: not false, $d: 1 < 2) { minus:$a; plus:$b; negated:$c; comparison:$d; }
.case-parameter-default-operands { @include values(); }

$gap: 8px;
@function minus() { @return -$gap; } @function plus() { @return +$gap; }
@function negated() { @return not false; } @function compared() { @return 1 < 2; }
.case-return-operands { minus:minus(); plus:plus(); negated:negated(); comparison:compared(); }

$gap: 8px; $x:(minus:-$gap, plus:+$gap, negated:not false, comparison:1 < 2);
.case-map-value-operands { minus:map.get($x, minus); plus:map.get($x, plus); negated:map.get($x, negated); comparison:map.get($x, comparison); }

$gap: 8px;
.case-interpolation-operands { minus:#{-$gap}; plus:#{+$gap}; negated:#{not false}; comparison:#{1 < 2}; }

$gap:8px; @function values($x:[-$gap, +$gap, not false, 1 < 2]) { @return $x; } $x:values(); .case-nested-list-default-return { minus:list.nth($x,1); plus:list.nth($x,2); negated:list.nth($x,3); comparison:list.nth($x,4); }

```


